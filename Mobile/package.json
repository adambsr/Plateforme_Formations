{
  "name": "@plateforme-formations/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-firebase/analytics": "^26.3.3",
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/messaging": "^26.3.3",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "~57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-picker": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.39.0",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint index.ts src tests",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/tests/mocks/lucide-react-native.tsx"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  },
  "private": true
}
