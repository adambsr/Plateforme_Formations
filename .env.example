# Optional Docker Compose overrides for Stripe sandbox and Gemini testing.
# Copy this file to the ignored repository-root .env and replace the placeholders.
MOBILE_APP_SCHEME=plateforme-formations
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/payments/success
STRIPE_CANCEL_URL=http://localhost:5173/payments/cancel

# Optional Gemini question generation. Create the key in Google AI Studio.
AI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-3.7-flash
AI_MAX_CONTEXT_CHARS=100000
