{
  "name": "@plateforme-formations/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "oxlint docker src tests",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/phase1.integration.test.ts tests/phase2.integration.test.ts tests/phase3-4.integration.test.ts tests/phase5.integration.test.ts tests/phase6-7.integration.test.ts tests/phase8-9.integration.test.ts tests/phase10.integration.test.ts tests/phase11.integration.test.ts --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "file-type": "^22.0.2",
    "jose": "^6.2.5",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^22.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
