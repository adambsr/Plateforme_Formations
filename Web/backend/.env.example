# Application and database
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/plateforme_formations?replicaSet=rs0&directConnection=true
WEB_APP_URL=http://localhost:5173
MOBILE_APP_SCHEME=plateforme-formations
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
TZ=UTC
LOG_LEVEL=debug

# Authentication and bootstrap
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# Used only by `npm run seed:admin`; replace both before running that command.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Email delivery (backend to SMTP provider)
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM=High Skills Academy <hsa.tn.contact@gmail.com>
EMAIL_CONTACT_TO=hsa.tn.contact@gmail.com
EMAIL_SUPPORT_ADDRESS=hsa.tn.contact@gmail.com
# When set, every outgoing message is redirected here and prefixed [TEST].
EMAIL_TEST_RECIPIENT=hsa.tn.contact@gmail.com

# Backend-only SMTP transport and credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=hsa.tn.contact@gmail.com
SMTP_PASSWORD=replace-with-a-Google-app-password
# Stripe test mode. Placeholders allow startup; replace them for checkout/webhooks.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/payments/success
STRIPE_CANCEL_URL=http://localhost:5173/payments/cancel

# Protected local file storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Gemini API (backend-only). The placeholder allows startup; replace it for AI features.
AI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-3.7-flash
AI_BASE_URL=
AI_MAX_CONTEXT_CHARS=100000

# Firebase Cloud Messaging (server-only; use Application Default Credentials)
FCM_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# Centre identity
CENTER_NAME=High Skills Academy
CENTER_ADDRESS=Route Manzel Chaker km 2.5 en face Magasin Général (MG), Sfax, Tunisia
CENTER_EMAIL=hsa.tn.contact@gmail.com
CENTER_PHONE=
CENTER_REGISTRATION_ID=
CENTER_LOGO_PATH=./assets/hsa-logo-blue.png
